{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug STM32H743 (ST-Link / OpenOCD)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "openocd",
      "serverpath": "${env:LOCALAPPDATA}\\Microsoft\\WinGet\\Packages\\xpack-dev-tools.openocd-xpack_Microsoft.Winget.Source_8wekyb3d8bbwe\\xpack-openocd-0.12.0-7\\bin\\openocd.exe",
      "searchDir": [
        "${env:LOCALAPPDATA}\\Microsoft\\WinGet\\Packages\\xpack-dev-tools.openocd-xpack_Microsoft.Winget.Source_8wekyb3d8bbwe\\xpack-openocd-0.12.0-7\\scripts"
      ],
      "configFiles": [
        "interface/stlink.cfg",
        "target/stm32h7x.cfg"
      ],
      "device": "STM32H743XI",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/Debug/stm32h7boot.elf",
      "gdbPath": "${env:USERPROFILE}\\tools\\xpack-arm-none-eabi-gcc-15.2.1-1.1\\bin\\arm-none-eabi-gdb.exe",
      "preLaunchTask": "Build Debug",
      "runToEntryPoint": "main",
      "showDevDebugOutput": "raw",
      "postLaunchCommands": [
        "monitor reset halt"
      ],
      "liveWatch": {
        "enabled": true,
        "samplesPerSecond": 4
      },
      "rttConfig": {
        "enabled": true,
        "address": "auto",
        "rtt_start_retry": 1000,
        "decoders": [
          {
            "port": 0,
            "type": "console",
            "label": "RTT Channel 0",
            "timestamp": true
          }
        ]
      }
    },
    {
      "name": "Debug STM32H743 (J-Link, requires SEGGER package)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "jlink",
      "serverpath": "C:\\Program Files\\SEGGER\\JLink\\JLinkGDBServerCL.exe",
      "device": "STM32H743XI",
      "interface": "swd",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/Debug/stm32h7boot.elf",
      "gdbPath": "${env:USERPROFILE}\\tools\\xpack-arm-none-eabi-gcc-15.2.1-1.1\\bin\\arm-none-eabi-gdb.exe",
      "preLaunchTask": "Build Debug",
      "runToEntryPoint": "main",
      "showDevDebugOutput": "raw",
      "postLaunchCommands": [
        "monitor reset halt"
      ],
      "liveWatch": {
        "enabled": true,
        "samplesPerSecond": 4
      },
      "rttConfig": {
        "enabled": true,
        "address": "auto",
        "rtt_start_retry": 1000,
        "decoders": [
          {
            "port": 0,
            "type": "console",
            "label": "RTT Channel 0",
            "timestamp": true
          }
        ]
      }
    }
  ]
}
