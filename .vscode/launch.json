{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug PC DAP",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "openocd",
      "device": "STM32H743XI",
      "interface": "swd",
      "runToEntryPoint": "main",
      "gdbPath": "D:/program/arm-none-eabi/14.2 rel1/bin/arm-none-eabi-gdb.exe",
      "serverpath": "D:/program/openocd/OpenOCD-20260121-0.12.0/bin/openocd.exe",
      "searchDir": [
        "D:/program/openocd/OpenOCD-20260121-0.12.0/share/openocd/scripts"
      ],
      "configFiles": [
        "interface/cmsis-dap.cfg",
        "target/stm32h7x.cfg"
      ],
      "executable": "${command:cmake.launchTargetPath}",
      "svdFile": "${workspaceFolder}/STM32H743.svd",
      "cwd": "${workspaceFolder}",
      "showDevDebugOutput": "raw",
      "liveWatch": {
        "enabled": true,
        "samplesPerSecond": 4
      }
    },
    {
      "name": "Debug PC J-Link",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "jlink",
      "device": "STM32H743XI",
      "interface": "swd",
      "runToEntryPoint": "main",
      "gdbPath": "C:/Program Files (x86)/Arm GNU Toolchain arm-none-eabi/14.2 rel1/bin/arm-none-eabi-gdb",
      "executable": "${command:cmake.launchTargetPath}",
      "svdFile": "${workspaceFolder}/STM32H743.svd",
      "cwd": "${workspaceFolder}",
      "showDevDebugOutput": "raw",
      "postLaunchCommands": [
        "monitor reset halt"
      ],
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            },
            "rttConfig": {
                "enabled": true,
                "address": "auto",
                "rtt_start_retry": 1000,
                "decoders": [
                    {
                        "port": 0,
                        "type": "console",
                        "label": "RTT Channel 0",
                        "timestamp": true
                    }
                ]
            }
    }
  ]
}