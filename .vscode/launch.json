{
  "version": "0.2.0",
  "configurations": [
    
    {
      "name": "Debug PC J-Link",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "jlink",
      "device": "STM32H743XI",
      "interface": "swd",
      "runToEntryPoint": "main",
      "gdbPath": "C:/DevToolchain/arm-gcc/14.2 rel1/bin/arm-none-eabi-gdb",
      "executable": "${command:cmake.launchTargetPath}",
      "svdFile": "${workspaceFolder}/STM32H743.svd",
      "cwd": "${workspaceFolder}",
      "showDevDebugOutput": "raw",
      "postLaunchCommands": [
        "monitor reset halt"
      ],
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            },
            "rttConfig": {
                "enabled": true,
                "address": "auto",
                "rtt_start_retry": 1000,
                "decoders": [
                    {
                        "port": 0,
                        "type": "console",
                        "label": "RTT Channel 0",
                        "timestamp": true
                    }
                ]
            }
    }
  ]
}