{
  "version": "2.0.0",
  "options": {
    "env": {
      "Path": "${env:USERPROFILE}\\tools\\cmake-4.2.3-windows-x86_64\\bin;${env:USERPROFILE}\\tools\\xpack-arm-none-eabi-gcc-15.2.1-1.1\\bin;${env:LOCALAPPDATA}\\Microsoft\\WinGet\\Packages\\Ninja-build.Ninja_Microsoft.Winget.Source_8wekyb3d8bbwe;${env:LOCALAPPDATA}\\Microsoft\\WinGet\\Packages\\xpack-dev-tools.openocd-xpack_Microsoft.Winget.Source_8wekyb3d8bbwe\\xpack-openocd-0.12.0-7\\bin;${env:LOCALAPPDATA}\\Programs\\Python\\Python313;${env:LOCALAPPDATA}\\Programs\\Python\\Python313\\Scripts;C:\\Program Files\\Git\\cmd;${env:Path}"
    }
  },
  "tasks": [
    {
      "label": "Configure Debug",
      "type": "shell",
      "command": "${env:USERPROFILE}\\tools\\cmake-4.2.3-windows-x86_64\\bin\\cmake.exe",
      "args": [
        "--preset",
        "Debug"
      ],
      "problemMatcher": []
    },
    {
      "label": "Build Debug",
      "type": "shell",
      "command": "${env:USERPROFILE}\\tools\\cmake-4.2.3-windows-x86_64\\bin\\cmake.exe",
      "args": [
        "--build",
        "--preset",
        "Debug",
        "-j",
        "8"
      ],
      "dependsOn": "Configure Debug",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc"
    },
    {
      "label": "Clean Debug",
      "type": "shell",
      "command": "${env:USERPROFILE}\\tools\\cmake-4.2.3-windows-x86_64\\bin\\cmake.exe",
      "args": [
        "--build",
        "--preset",
        "Debug",
        "--target",
        "clean"
      ],
      "problemMatcher": []
    },
    {
      "label": "Flash Debug (CMSIS-DAP / OpenOCD)",
      "type": "shell",
      "command": "${env:LOCALAPPDATA}\\Microsoft\\WinGet\\Packages\\xpack-dev-tools.openocd-xpack_Microsoft.Winget.Source_8wekyb3d8bbwe\\xpack-openocd-0.12.0-7\\bin\\openocd.exe",
      "args": [
        "-f",
        "interface/cmsis-dap.cfg",
        "-f",
        "target/stm32h7x.cfg",
        "-c",
        "adapter serial DA4160F4A34411D7",
        "-c",
        "program ${workspaceFolder}/build/Debug/stm32h7boot.elf verify reset exit"
      ],
      "dependsOn": "Build Debug",
      "problemMatcher": []
    }
  ]
}
