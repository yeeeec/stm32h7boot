{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
		    "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
            }
        },
        {
            "name": "Debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BOOT_VARIANT": "prod"
            }
        },
        {
            "name": "RelWithDebInfo",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "BOOT_VARIANT": "prod"
            }
        },
        {
            "name": "Release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BOOT_VARIANT": "prod"
            }
        },
        {
            "name": "MinSizeRel",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "MinSizeRel",
                "BOOT_VARIANT": "prod"
            }
        },
        {
            "name": "TestDebug",
            "inherits": "Debug",
            "cacheVariables": {
                "BOOT_VARIANT": "test"
            }
        },
        {
            "name": "TestRelease",
            "inherits": "Release",
            "cacheVariables": {
                "BOOT_VARIANT": "test"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "RelWithDebInfo",
            "configurePreset": "RelWithDebInfo"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        },
        {
            "name": "MinSizeRel",
            "configurePreset": "MinSizeRel"
        },
        {
            "name": "TestDebug",
            "configurePreset": "TestDebug"
        },
        {
            "name": "TestRelease",
            "configurePreset": "TestRelease"
        }
    ]
}
