{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/hmi/manifest.schema.json",
  "title": "HMI RAW APP/GUI Upgrade Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "package_id", "release", "target", "components"],
  "properties": {
    "format_version": { "const": 1 },
    "package_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[A-Za-z0-9._+-]+$"
    },
    "release": { "$ref": "#/$defs/release" },
    "target": { "$ref": "#/$defs/target" },
    "components": { "$ref": "#/$defs/components" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "minor", "patch", "build"],
      "properties": {
        "major": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "minor": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "patch": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "build": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "hardware", "minimum_bootloader_version"],
      "properties": {
        "product": { "const": "HMI" },
        "hardware": { "const": "STM32H743-W25Q256" },
        "minimum_bootloader_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "format", "size", "sha256"],
      "properties": {
        "file": { "type": "string" },
        "format": { "const": "raw-bin-v1" },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["app", "gui"],
      "properties": {
        "app": {
          "allOf": [
            { "$ref": "#/$defs/component" },
            { "properties": { "file": { "const": "hmi.app.bin" }, "size": { "maximum": 1048576 } } }
          ]
        },
        "gui": {
          "allOf": [
            { "$ref": "#/$defs/component" },
            { "properties": { "file": { "const": "hmi.gui.bin" }, "size": { "maximum": 8388608 } } }
          ]
        }
      }
    }
  }
}
